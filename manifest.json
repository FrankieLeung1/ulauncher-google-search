{
  "name": "Google Search",
  "required_api_version": "^2.0.0",
  "description": "Search from Google",
  "developer_name": "Samy NASTUZZI",
  "icon": "images/icon.png",
  "options": {
    "query_debounce": 0.1
  },
  "preferences": [
    {
      "id": "google_search_keyword",
      "type": "keyword",
      "name": "Google Search",
      "description": "Search from Google",
      "default_value": "i"
    },
    {
      "id": "search_engine",
      "type": "select",
      "name": "Search Engine",
      "description": "Search engine used for suggestions and search queries",
      "default_value": "google",
      "options": [
        {"value": "google", "text": "Google"},
        {"value": "bing", "text": "Bing"},
        {"value": "duckduckgo", "text": "DuckDuckGo"},
        {"value": "startpage", "text": "Startpage"},
        {"value": "ecosia", "text": "Ecosia"}
      ]
    },
    {
      "id": "incognito",
      "type": "checkbox",
      "name": "Incognito",
      "description": "Launch browser in a private/incognito window",
      "default_value": false
    },
    {
      "id": "show_suggestions",
      "type": "checkbox",
      "name": "Show suggestions",
      "description": "Fetch autocomplete suggestions (adds network delay before Enter updates)",
      "default_value": true
    }
  ]
}

